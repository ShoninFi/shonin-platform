# syntax=docker/dockerfile:1
# The keeper: collects bills, values and settles, serves claims, relays the
# executor's blessings and stocks its keys with gas.
# Runs on the services VM (deploy/gcp/services), beside the API.
# Built from the repository root by `task cloud:build NAME=keeper NETWORK=testnet`,
# which passes the network's settings and its deployments directory:
#   docker build --build-arg NETWORK_FEATURE=none --build-arg WITHOUT_SOLANA=1 --build-arg NETWORK=testnet \
#     --build-arg EXECUTOR_URL=... \
#     --build-context deployments=.shonin/testnet/deployments \
#     -f deploy/gcp/Dockerfile.keeper .
#
# Everything it runs with is in the image but its key: on a testnet the
# keeper role's key alone, SHONIN_TESTNET_KEEPER_KEY, handed to the container
# where it is started (an env file only root can read, on the services VM).
# The chains' endpoints are the public ones committed in config/chains.toml.

FROM rust:1.98.1-slim-bookworm AS build
WORKDIR /src
COPY . .
# The network whose Solana program ids are compiled in: devnet for a testnet
# image, mainnet for a mainnet one, or none for an image that serves no
# Solana cluster (task cloud:build passes it, with WITHOUT_SOLANA=1 for none).
# The local keypairs never reach the build, so an image without the ids could
# reach no cluster.
ARG NETWORK_FEATURE
# rust-toolchain.toml pins the same compiler; --locked builds exactly Cargo.lock.
RUN : "${NETWORK_FEATURE:?pass --build-arg NETWORK_FEATURE=devnet, mainnet or none}" && \
    features="" && { [ "$NETWORK_FEATURE" = none ] || features="--features $NETWORK_FEATURE"; } && \
    cargo build --release --locked -p shonin-keeper --bin keeper $features

FROM gcr.io/distroless/cc-debian12:nonroot
ARG NETWORK
# 1 where the image serves the network's EVM chains alone (no Solana ids in it).
ARG WITHOUT_SOLANA=
ARG EXECUTOR_URL
COPY --from=build /src/target/release/keeper /usr/local/bin/keeper
COPY config/chains.toml /etc/shonin/chains.toml
# The generation's deployment files: the named build context `deployments`
# (a build without it fails here).
COPY --from=deployments *.json /etc/shonin/deployments/${NETWORK}/
ENV SHONIN_NETWORK=${NETWORK} \
    SHONIN_WITHOUT_SOLANA=${WITHOUT_SOLANA} \
    SHONIN_CHAINS=/etc/shonin/chains.toml \
    SHONIN_DEPLOYMENTS_DIR=/etc/shonin/deployments/${NETWORK} \
    SHONIN_EXECUTOR_URL=${EXECUTOR_URL}
ENTRYPOINT ["/usr/local/bin/keeper"]
CMD ["--port", "19087", "--listen", "0.0.0.0"]
