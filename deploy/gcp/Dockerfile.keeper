# syntax=docker/dockerfile:1
# The keeper: crystallises fees, settles claims, freezes.
# Runs on Cloud Run.
# Built from the repository root: task cloud:build NAME=keeper
#   (docker build -f deploy/gcp/Dockerfile.keeper .)

FROM rust:1.98.1-slim-bookworm AS build
WORKDIR /src
COPY . .
# rust-toolchain.toml pins the same compiler; --locked builds exactly Cargo.lock.
RUN cargo build --release --locked -p shonin-keeper --bin keeper

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/keeper /usr/local/bin/keeper
COPY config/chains.toml /etc/shonin/chains.toml
COPY config/deployments /etc/shonin/deployments
# The network (SHONIN_NETWORK) and its deployments directory
# (SHONIN_DEPLOYMENTS_DIR=/etc/shonin/deployments/<network>) are set where the
# image is launched.
ENV SHONIN_CHAINS=/etc/shonin/chains.toml
ENTRYPOINT ["/usr/local/bin/keeper"]
