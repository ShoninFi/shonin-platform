# syntax=docker/dockerfile:1
# The reference indexer: reads the chain into the record.
# Not deployed in the cloud: the API runs the same indexer in-process.
# Built from the repository root: task cloud:build NAME=indexer NETWORK=testnet
#   (docker build --build-arg NETWORK_FEATURE=devnet -f deploy/gcp/Dockerfile.indexer .)

FROM rust:1.98.1-slim-bookworm AS build
WORKDIR /src
COPY . .
# The network whose Solana program ids are compiled in: devnet for a testnet
# image, mainnet for a mainnet one (task cloud:build passes it). The local
# keypairs never reach the build, so an image without it could reach no
# cluster.
ARG NETWORK_FEATURE
# rust-toolchain.toml pins the same compiler; --locked builds exactly Cargo.lock.
RUN : "${NETWORK_FEATURE:?pass --build-arg NETWORK_FEATURE=devnet or mainnet}" && \
    cargo build --release --locked -p shonin-indexer --bin indexer --features "$NETWORK_FEATURE"

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/indexer /usr/local/bin/indexer
COPY config/chains.toml /etc/shonin/chains.toml
# Only mainnet addresses are committed, so only they are baked in; the network
# (SHONIN_NETWORK) and its deployments directory (SHONIN_DEPLOYMENTS_DIR) are
# set where the image is launched.
COPY config/deployments/mainnet /etc/shonin/deployments/mainnet
ENV SHONIN_CHAINS=/etc/shonin/chains.toml
ENTRYPOINT ["/usr/local/bin/indexer"]
