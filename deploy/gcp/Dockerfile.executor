# syntax=docker/dockerfile:1
# The executor: runs strategies and trades for their vaults.
# Runs on a Confidential Space VM, which attests to this image by its digest.
# Built from the repository root by `task cloud:build NAME=executor NETWORK=testnet`,
# which passes the network's settings and its deployments directory:
#   docker build --build-arg NETWORK_FEATURE=none --build-arg WITHOUT_SOLANA=1 --build-arg NETWORK=testnet \
#     --build-arg STORE_URL=... --build-arg API_URL=... \
#     --build-context deployments=.shonin/testnet/deployments \
#     -f deploy/gcp/Dockerfile.executor .
#
# Everything it runs with is in the image, its arguments included: the
# attestation refuses a launch that overrides the image's command or
# environment, so a change of settings is a new image, and a new digest to
# allow. It holds no key from outside: every key it signs with is made inside
# the enclave.

# Where the build starts from: the `deps` stage below, or (in Cloud Build)
# that stage already built and pushed as an image named for everything it
# is made from (deploy/gcp/cloudbuild/build.sh).
ARG DEPS=deps

# The toolchain rust-toolchain.toml pins, with its targets, and cargo-chef.
FROM rust:1.98.1-slim-bookworm AS chef
WORKDIR /src
COPY rust-toolchain.toml ./
RUN rustup toolchain install && rustup show active-toolchain && \
    cargo install cargo-chef --locked --version 0.1.78

# What the dependencies are, from the manifests alone.
FROM chef AS recipe
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# The dependencies alone, compiled from the recipe.
FROM chef AS deps
# The network whose Solana program ids are compiled in: devnet for a testnet
# image, mainnet for a mainnet one, or none for an image that serves no
# Solana cluster (task cloud:build passes it, with WITHOUT_SOLANA=1 for none).
ARG NETWORK_FEATURE
# ONNX Runtime, the inference host's library: Microsoft's own release, pinned
# by its hash, linked dynamically and carried into the image, rather than
# fetched by the build from a third party's mirror.
ADD --checksum=sha256:a3e1b79d7bb1bf09696ce675f49e4064e6c81f6202b8225624fff0e93f8d6407 \
    https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-linux-x64-1.28.0.tgz /tmp/onnxruntime.tgz
RUN mkdir -p /opt/onnxruntime && \
    tar -xzf /tmp/onnxruntime.tgz -C /opt/onnxruntime --strip-components=1 && \
    ln -sf libonnxruntime.so.1 /opt/onnxruntime/lib/libonnxruntime.so
ENV ORT_LIB_LOCATION=/opt/onnxruntime/lib \
    ORT_PREFER_DYNAMIC_LINK=1
# Thin LTO over 16 codegen units links in a fraction of the time of the
# workspace's fat, single-unit release. It changes only how the host binary
# is optimised: an agent's code is compiled by the runtime at start, so what
# it is metered in fuel is the same, and the build stays reproducible.
ENV CARGO_PROFILE_RELEASE_LTO=thin \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
COPY --from=recipe /src/recipe.json recipe.json
# The Solana programs' crates the chain crate names by path: outside the
# workspace, so the recipe carries no skeleton of them.
COPY contracts/solana contracts/solana
RUN : "${NETWORK_FEATURE:?pass --build-arg NETWORK_FEATURE=devnet, mainnet or none}" && \
    features="" && { [ "$NETWORK_FEATURE" = none ] || features="--features $NETWORK_FEATURE"; } && \
    cargo chef cook --release --locked -p shonin-executor --bin executor $features --recipe-path recipe.json

# Then the platform itself. rust-toolchain.toml pins the same compiler;
# --locked builds exactly Cargo.lock.
FROM ${DEPS} AS build
ARG NETWORK_FEATURE
COPY . .
RUN : "${NETWORK_FEATURE:?pass --build-arg NETWORK_FEATURE=devnet, mainnet or none}" && \
    features="" && { [ "$NETWORK_FEATURE" = none ] || features="--features $NETWORK_FEATURE"; } && \
    cargo build --release --locked -p shonin-executor --bin executor $features && \
    mkdir -p /out/store

# Root inside the container: the launcher's token socket
# (/run/container_launcher/teeserver.sock) is the launcher's, and the
# container is the machine's only workload.
FROM gcr.io/distroless/cc-debian12
# Confidential Space's hardened image sends the container's lines to Cloud
# Logging only where the image allows it.
LABEL "tee.launch_policy.log_redirect"="always"
ARG NETWORK
# 1 where the image serves the network's EVM chains alone (no Solana ids in it).
ARG WITHOUT_SOLANA=
ARG STORE_URL
ARG API_URL
COPY --from=build /src/target/release/executor /usr/local/bin/executor
COPY --from=build /opt/onnxruntime/lib/libonnxruntime.so.1 /opt/onnxruntime/lib/libonnxruntime.so.1.28.0 /usr/lib/x86_64-linux-gnu/
COPY config/chains.toml /etc/shonin/chains.toml
# The generation's deployment files: the named build context `deployments`
# (a build without it fails here).
COPY --from=deployments *.json /etc/shonin/deployments/${NETWORK}/
# The store's local copy: filled from the public store, each file believed
# only for its hash.
COPY --from=build /out/store /var/lib/shonin/store
ENV SHONIN_NETWORK=${NETWORK} \
    SHONIN_WITHOUT_SOLANA=${WITHOUT_SOLANA} \
    SHONIN_CHAINS=/etc/shonin/chains.toml \
    SHONIN_DEPLOYMENTS_DIR=/etc/shonin/deployments/${NETWORK} \
    SHONIN_STORE=/var/lib/shonin/store \
    SHONIN_STORE_URL=${STORE_URL} \
    SHONIN_API_URL=${API_URL}
# Confidential Space opens only the ports an image declares.
EXPOSE 19085/tcp
ENTRYPOINT ["/usr/local/bin/executor"]
# The status port is open to the VPC (the keeper, the waker and the prover
# read it); the tokens come from the launcher.
CMD ["--attestation", "launcher", "--port", "19085", "--listen", "0.0.0.0"]
