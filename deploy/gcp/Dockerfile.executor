# syntax=docker/dockerfile:1
# The executor: runs strategies and trades for their vaults.
# Runs on a Confidential Space VM, which attests to this image by its digest.
# Built from the repository root: task cloud:build NAME=executor
#   (docker build -f deploy/gcp/Dockerfile.executor .)

FROM rust:1.98.1-slim-bookworm AS build
WORKDIR /src
COPY . .
# rust-toolchain.toml pins the same compiler; --locked builds exactly Cargo.lock.
RUN cargo build --release --locked -p shonin-executor --bin executor

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/executor /usr/local/bin/executor
COPY config/chains.toml /etc/shonin/chains.toml
COPY config/deployments /etc/shonin/deployments
# The network (SHONIN_NETWORK) and its deployments directory
# (SHONIN_DEPLOYMENTS_DIR=/etc/shonin/deployments/<network>) are set where the
# image is launched.
ENV SHONIN_CHAINS=/etc/shonin/chains.toml
ENTRYPOINT ["/usr/local/bin/executor"]
