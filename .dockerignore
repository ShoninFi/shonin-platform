# The images build from the repository root. Nothing secret, local or built
# goes into the build context: only what `cargo build --locked` needs.
.env
.env.*
claude-api-key
*.key
*.pem
.private/
.claude/
.git/
.shonin/
.task/
.trunk-dist/
.wrangler/
node_modules/
target/
**/target/
docs/
cloudflare/
contracts/evm/lib/
contracts/evm/out/
contracts/evm/cache/
# The Solana programs' sources are the services' interface to them; their
# build output (target/, with the local keypairs) stays out.
packages/frontend/app/tests/
**/.DS_Store
