package shonin:agent@0.1.0;

/// The small vocabulary every other interface is written in.
interface types {
    /// Which driver an action or a query is for, as `shonin.toml` names it.
    type driver-name = string;
    /// Bytes a driver understands. Its executor half decodes them inside the
    /// measured image; an agent builds them with the driver's typed crate.
    type payload = list<u8>;

    /// What the driver did with one action.
    variant verdict {
        /// Its receipt: a fill, an order id, whatever the venue returns.
        accepted(payload),
        rejected(string),
    }
}

/// The only way out to a venue. An agent submits actions through a driver
/// and is told what happened to them; it never holds a key and never signs
/// anything.
interface drivers {
    use types.{driver-name, payload, verdict};

    submit: async func(driver: driver-name, actions: list<payload>) -> list<verdict>;
    /// Fills, order updates and liquidations on the vault's own account.
    account-events: func(driver: driver-name) -> stream<payload>;
    account-state: async func(driver: driver-name, query: payload) -> result<payload, string>;
}

/// Moving the vault's own money between its own accounts.
///
/// Every move is a call the contracts check: money only ever goes from the
/// vault's cash to its station, between a station and the venue accounts it
/// owns, back home, and over a declared bridge to the same station address on
/// another chain. The vault's idle floor holds whatever the agent asks for.
/// Amounts are in the dollar's smallest unit, millionths of a dollar.
interface transfers {
    use types.{driver-name};

    /// A venue account a station owns: on that chain, through that driver.
    record venue-account {
        chain: string,
        driver: driver-name,
    }

    /// One of the vault's own accounts. Chains are named as `shonin.toml`
    /// names them.
    variant account {
        /// The vault's cash, on the vault's own chain.
        vault,
        /// A station's idle dollars.
        station(string),
        venue(venue-account),
    }

    record balance {
        account: account,
        amount: u64,
    }

    /// The vault's own chain.
    home-chain: func() -> string;
    /// Move between two accounts on one chain. Moving from the vault's cash
    /// to a venue goes through the station on the way.
    move: async func(source: account, destination: account, amount: u64) -> result<_, string>;
    /// Send a station's idle dollars over a declared bridge to the same
    /// station on another chain.
    bridge: async func(name: string, source-chain: string, destination-chain: string, amount: u64) -> result<_, string>;
    /// What each of the vault's accounts holds now.
    balances: async func() -> list<balance>;
}

/// What the vault tells the agent about itself.
interface vault {
    variant vault-event {
        /// A depositor is leaving and their fraction is being closed. The
        /// payload carries which fraction.
        claim-pending(list<u8>),
        /// The vault is stopping. The agent has a grace period to unwind
        /// itself before the contract does it.
        halting(string),
        /// The vault's cash is short of what waiting withdrawals and the idle
        /// floor need, by this many millionths of a dollar. Bringing money
        /// home now saves a leaver from waiting for a claim.
        buffer-low(u64),
    }

    events: func() -> stream<vault-event>;
}

/// Reads the executor makes for the agent: prices, order books. Each call is
/// read from the chain as it is made; nothing is yet cached or shared between
/// agents, and no quota holds an agent's reads down.
interface data {
    use types.{driver-name, payload};

    query: async func(source: string, request: payload) -> result<payload, string>;
    subscribe: func(driver: driver-name, feed: payload) -> result<stream<payload>, string>;
}

/// A socket to any host, terminated by the executor so the agent never
/// holds a certificate or a key.
interface websocket {
    resource connection {
        send: async func(message: list<u8>) -> result<_, string>;
        messages: func() -> stream<list<u8>>;
    }

    connect: async func(url: string, headers: list<tuple<string, string>>) -> result<connection, string>;
}

/// Values sealed to the bundle's own hash. The agent can use them and
/// nobody, including the platform, can read them.
interface secrets {
    get: func(name: string) -> option<string>;
}

/// A per-agent cache. It usually survives a restart and is promised to
/// nobody: an agent rebuilds what it needs from the venue's own state.
interface state {
    get: func(key: string) -> option<list<u8>>;
    set: func(key: string, value: list<u8>);
    delete: func(key: string);
}

/// Running a model the bundle carries. Inference is budgeted, and going over
/// budget is an error the agent handles rather than a stall.
interface inference {
    variant tensor-data {
        float32(list<f32>),
        float64(list<f64>),
        int32(list<s32>),
        int64(list<s64>),
        uint8(list<u8>),
    }

    /// Row-major.
    record tensor {
        shape: list<u32>,
        data: tensor-data,
    }

    record named-tensor {
        name: string,
        tensor: tensor,
    }

    variant inference-error {
        unknown-model(string),
        invalid-input(string),
        quota-exceeded(string),
        backend-error(string),
    }

    infer: async func(model: string, inputs: list<named-tensor>) -> result<list<named-tensor>, inference-error>;
}

/// One long-lived program. The host starts `run` once and never schedules it
/// again: everything the agent does, it does inside that call.
world agent {
    import types;
    import drivers;
    import transfers;
    import vault;
    import data;
    import websocket;
    import state;
    import inference;
    import secrets;

    export run: async func() -> result<_, string>;
}
