package shonin:agent@0.1.0;

/// The small vocabulary every other interface is written in.
interface types {
    /// Which driver an action or a query is for, as `shonin.toml` names it.
    type driver-name = string;
    /// Bytes a driver understands. Its executor half decodes them inside the
    /// measured image; an agent builds them with the driver's typed crate.
    type payload = list<u8>;

    /// What the driver did with one action.
    variant verdict {
        /// Its receipt: a fill, an order id, whatever the venue returns.
        accepted(payload),
        /// It was refused, or could not be sent at all: nothing happened.
        rejected(string),
        /// It was sent and no answer came back, so it may still land. Read
        /// the account before acting as though it didn't: sending it again
        /// could do it twice.
        unknown(string),
    }
}

/// The only way out to a venue. An agent submits actions through a driver
/// and is told what happened to them; it never holds a key and never signs
/// anything.
interface drivers {
    use types.{driver-name, payload, verdict};

    /// One verdict for each action, in the order given. Whether the actions
    /// of one call land together is the driver's: the `local` driver sends
    /// every order of one call in one transaction, each order decided on its
    /// own (not atomic); the other drivers send each action on its own. No
    /// driver makes a call's actions atomic, so read each verdict.
    submit: async func(driver: driver-name, actions: list<payload>) -> list<verdict>;
    /// Fills, order updates and liquidations on the vault's own account, and
    /// news of the markets the agent follows.
    account-events: func(driver: driver-name) -> stream<payload>;
    /// The account now. The query is the driver's: the `local` driver's names
    /// the markets the agent follows, and so is woken for.
    account-state: async func(driver: driver-name, query: payload) -> result<payload, string>;
}

/// Moving the vault's own money between its own accounts.
///
/// Every move is a call the contracts check: money only ever goes from the
/// vault's cash to its station, between a station and the venue accounts it
/// owns, back home, and over a declared bridge to the same station address on
/// another chain. The vault's idle floor holds whatever the agent asks for.
/// Amounts are in the dollar's smallest unit, millionths of a dollar.
interface transfers {
    use types.{driver-name};

    /// A venue account a station owns: on that chain, through that driver.
    record venue-account {
        chain: string,
        driver: driver-name,
    }

    /// One of the vault's own accounts. Chains are named as `shonin.toml`
    /// names them.
    variant account {
        /// The vault's cash, on the vault's own chain.
        vault,
        /// A station's idle dollars.
        station(string),
        venue(venue-account),
    }

    record balance {
        account: account,
        amount: u64,
    }

    /// The vault's accounts as one read found them.
    record balances-read {
        /// Each account read, and what it holds.
        read: list<balance>,
        /// Each account whose read failed: what it holds is unknown, not
        /// nothing, so `read` adds up to less than the vault is worth.
        unread: list<account>,
    }

    /// Where a move stopped short, and why.
    record partial-move {
        /// The vault's own account the money reached on the way, and is in
        /// now.
        reached: account,
        /// Why it went no further.
        reason: string,
        /// Whether the step after `reached` was sent and went unanswered, in
        /// which case it may still land and the money may yet arrive.
        may-still-land: bool,
    }

    /// How far a move got.
    variant moved {
        /// All of it arrived where it was going.
        done,
        /// None of it moved: the contracts refused, or it could not be sent.
        refused(string),
        /// It was sent and no answer came back, so it may still land. Read
        /// the balances before moving the same money again.
        unknown(string),
        /// It took more than one step and stopped on the way, in one of the
        /// vault's own accounts.
        partial(partial-move),
    }

    /// The vault's own chain.
    home-chain: func() -> string;
    /// Move between two accounts on one chain. Moving from the vault's cash
    /// to a venue goes through the station on the way.
    move: async func(source: account, destination: account, amount: u64) -> moved;
    /// Send a station's idle dollars over a declared bridge to the same
    /// station on another chain.
    bridge: async func(name: string, source-chain: string, destination-chain: string, amount: u64) -> moved;
    /// What each of the vault's accounts holds now. An account whose read
    /// failed is left out; `read-balances` says which.
    balances: async func() -> list<balance>;
    /// What each of the vault's accounts holds now, and which of them could
    /// not be read.
    read-balances: async func() -> balances-read;
}

/// What the vault tells the agent about itself.
interface vault {
    /// A withdrawal the vault's cash couldn't pay.
    record claim {
        /// The vault's own number for it.
        id: u64,
        /// The fraction of every position being closed to pay it, in parts
        /// per 10^18 (so 10^18 is the whole vault).
        fraction: u64,
    }

    variant vault-event {
        /// A depositor is leaving and their fraction of every position is
        /// being closed.
        claim-pending(claim),
        /// The vault is stopping. The agent has a grace period to unwind
        /// itself before the contract does it.
        halting(string),
        /// The vault's cash is short of what waiting withdrawals and the idle
        /// floor need, by this many millionths of a dollar. Bringing money
        /// home now saves a leaver from waiting for a claim.
        buffer-low(u64),
    }

    events: func() -> stream<vault-event>;
}

/// Shonin's shared data: reads the executor makes for the agent, and the
/// venues' streams, each read once for every agent on the machine.
interface data {
    use types.{payload};

    /// One value from a shared stream.
    record stamped {
        /// When the executor received it, in milliseconds since the Unix
        /// epoch, by the machine's clock.
        received-ms: u64,
        /// When the source says it was made, where the source says so.
        source-ms: option<u64>,
        /// The value, in the payload format the SDK reads for that source.
        value: payload,
    }

    /// A read made now, such as the stand-in venue's markets.
    query: async func(source: string, request: payload) -> result<payload, string>;
    /// One of Shonin's shared streams: `source` names the venue (such as
    /// `hyperliquid`), and `feed` says which of its feeds, built with the
    /// SDK. The executor holds one connection per venue, whoever listens, so
    /// an agent never meets the venue's limits on connections. Nothing is
    /// promised about freshness beyond each value's own stamps; a value an
    /// agent is too slow to read may be dropped for a newer one.
    subscribe: func(source: string, feed: payload) -> result<stream<stamped>, string>;
}

/// A WebSocket to any host, outbound only. The executor ends TLS, so the
/// agent never holds a socket or a certificate; it reconnects nothing on the
/// agent's behalf. Connections, message sizes and the message rate are held
/// to the vault's allowances, and every byte counts against its bandwidth.
/// An agent opens them only if its manifest declares `network`.
interface websocket {
    variant message {
        text(string),
        binary(list<u8>),
    }

    resource connection {
        send: async func(message: message) -> result<_, string>;
        /// What the host sends, until it closes the connection or the
        /// connection fails.
        messages: func() -> stream<message>;
    }

    connect: async func(url: string, headers: list<tuple<string, string>>) -> result<connection, string>;
}

/// Values sealed to the bundle's own hash. The agent can use them and
/// nobody, including the platform, can read them.
interface secrets {
    get: func(name: string) -> option<string>;
}

/// Running a model the bundle carries. Inference is budgeted, and going over
/// budget is an error the agent handles rather than a stall.
interface inference {
    variant tensor-data {
        float32(list<f32>),
        float64(list<f64>),
        int32(list<s32>),
        int64(list<s64>),
        uint8(list<u8>),
    }

    /// Row-major.
    record tensor {
        shape: list<u32>,
        data: tensor-data,
    }

    record named-tensor {
        name: string,
        tensor: tensor,
    }

    variant inference-error {
        unknown-model(string),
        invalid-input(string),
        quota-exceeded(string),
        backend-error(string),
    }

    infer: async func(model: string, inputs: list<named-tensor>) -> result<list<named-tensor>, inference-error>;
}

/// One long-lived program. The host starts `run` once and never schedules it
/// again: everything the agent does, it does inside that call.
///
/// Besides Shonin's own interfaces, the agent has the standard WASI packages
/// under `deps/` (unchanged from the WASI project):
///
/// - `wasi:keyvalue` is the agent's state: 64 MiB, counted as the bytes of
///   every key (with its bucket's name) and value, a write past it refused.
///   It starts empty every time the agent starts, so an agent always
///   rebuilds what matters from the venue.
/// - `wasi:http` sends requests to any host, outbound only, under the same
///   quotas as `websocket`, if the manifest declares `network`.
/// - clocks, randomness and somewhere to print, from the WASI 0.2 packages.
///   No filesystem, no environment and no sockets of its own.
world agent {
    import types;
    import drivers;
    import transfers;
    import vault;
    import data;
    import websocket;
    import inference;
    import secrets;
    import wasi:keyvalue/store@0.2.0-draft;
    import wasi:keyvalue/atomics@0.2.0-draft;
    import wasi:keyvalue/batch@0.2.0-draft;
    import wasi:http/outgoing-handler@0.2.12;

    export run: async func() -> result<_, string>;
}
