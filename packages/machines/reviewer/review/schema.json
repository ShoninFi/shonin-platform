{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "limits", "answers"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "What the code does, in the reviewer's own words, beside the author's."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "severity", "summary", "detail", "file", "line"],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "security",
              "financial-risk",
              "reliability",
              "reproducibility",
              "outside-influence",
              "accurate-description"
            ]
          },
          "severity": { "type": "string", "enum": ["note", "concern", "serious"] },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What this review could not see."
    },
    "answers": {
      "type": "array",
      "description": "One answer for every question in the battery.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "probability", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
