# Secrets and per-developer settings ONLY. Non-secret config lives in
# taskfiles/config.yml and config/chains.toml. Copy this file to .env
# (gitignored) and fill it in.

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
# An ACCOUNT API token (owned by the account, not a user, so it keeps working
# regardless of who created it). The deploy tasks use it instead of a global
# `wrangler login`: they `requires:` both vars and map the token to wrangler's
# CLOUDFLARE_API_TOKEN; wrangler reads CLOUDFLARE_ACCOUNT_ID from the env.
#
# Create in the dashboard: Manage Account -> Account API Tokens -> Create Token
# (needs Super Administrator on the account), with:
#   Account · Workers Scripts · Edit
#
# The account ID is on the dashboard's account home page (right-hand sidebar).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DEPLOY_WORKERS_TOKEN=

# R2's S3 keys, for `task store:sync NETWORK=testnet`, which copies the
# published strategies' files to the content store's public copy (the bucket
# behind https://testnet-store.shonin.fi). Account-wide: they stay on this
# machine and never go into the cloud or an image.
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=

# The token of the Cloudflare tunnel that carries the testnet API to its
# public name. `task cloud:secrets NETWORK=testnet` uploads it to Secret
# Manager for the services VM; nothing else reads it.
# CLOUDFLARE_TUNNEL_TOKEN_TESTNET=

# ---------------------------------------------------------------------------
# Which chains
# ---------------------------------------------------------------------------
# local (the default: the chains `task dev` starts), testnet or mainnet. The
# chains each one means are in config/chains.toml. A task also takes
# NETWORK=testnet on its own command line (which wins), or NETWORK=testnet in
# the environment; NETWORK and SHONIN_NETWORK naming different networks are
# refused.
# SHONIN_NETWORK=local

# The deployment generation a deploy goes under (the salt of the station
# factory and the other contracts at one address on every chain). A clean
# redeploy of a network beside an older deployment needs a new one, the same
# for every chain: `task chains:deploy NETWORK=testnet GENERATION=<n>` (which
# wins over this). Each deployment file records its own; unset, a deploy
# takes the generation of the chains it keeps, or 0.
# SHONIN_GENERATION=

# Endpoint overrides for any chain in config/chains.toml, named by its key:
# SHONIN_RPC_<KIND>_<ID> and SHONIN_WS_<KIND>_<ID>, the id upper-cased with
# anything but letters and digits as "_". A paid RPC URL carries its key, so
# it lives here and never in the committed file.
# SHONIN_RPC_EVM_8453=
# SHONIN_RPC_EVM_84532=
# SHONIN_RPC_SOLANA_DEVNET=
# SHONIN_WS_SOLANA_DEVNET=

# Endpoints for log queries alone, and the most blocks one log query may span,
# per chain, named the same way: SHONIN_LOGS_RPC_<KIND>_<ID> (space-separated,
# like an RPC override; every eth_getLogs goes through a failover over these
# and nothing else does) and SHONIN_LOG_RANGE_<KIND>_<ID> (a positive whole
# number; a range is read in windows of at most that many blocks, both ends
# included). A provider that keeps a chain's past state may answer only narrow
# log queries, and one that answers wide ones may not keep the past. The width
# belongs to the list, not to one endpoint, since the failover picks the
# endpoint beneath each query: it must suit every endpoint in the list (the
# chain's RPC endpoints when no logs list is set). Unset or empty: logs use the
# chain's RPC endpoints, and a range is asked for whole (halved when refused).
# A logs URL may carry a key too, and is kept out of logs and errors the same.
# SHONIN_LOGS_RPC_EVM_84532=https://sepolia.base.org
# SHONIN_LOG_RANGE_EVM_84532=500

# ---------------------------------------------------------------------------
# Mainnet source verification
# ---------------------------------------------------------------------------
# An Etherscan API key, for `task chains:verify-source NETWORK=mainnet
# SUBMIT=1`: Etherscan's v2 API takes one key for every chain it serves
# (Base, HyperEVM and Robinhood Chain among them). The task hands it to forge
# in its environment alone, and takes it out of everything it prints.
# ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Testnets
# ---------------------------------------------------------------------------
# The testnet roles are accounts derived from these, in the same order as the
# local ones below: EVM m/44'/60'/0'/0/<index>, Solana m/44'/501'/<index>'/0'
# (0 deployer, 1 the program's own address). `task chains:accounts
# NETWORK=testnet` lists them and their gas; fund them from the faucets. Keep
# them to testnet money: they sit in plain text here.
# SHONIN_TESTNET_EVM_MNEMONIC=
# SHONIN_TESTNET_SOLANA_MNEMONIC=

# The keeper role's key alone (a 0x private key, account 4 of the mnemonic
# above): what the keeper starts from where the mnemonic isn't, as on the
# services VM (`task cloud:secrets` derives and uploads it; it is refused
# unless its address is the deployment's keeper). Without either, a testnet
# service only reads.
# SHONIN_TESTNET_KEEPER_KEY=
# The keeper's Solana devnet key alone, likewise: its keypair as the Solana
# tools write one (a JSON array of 64 numbers) or as base58, refused unless it
# is the keeper solana-devnet.json names. Without it, or the Solana mnemonic
# above, a service reads devnet only.
# SHONIN_TESTNET_KEEPER_SOLANA_KEY=

# A public copy of the content store, which the executor and the API read
# through to for any file not on disk, checking each against its hash. The
# cloud images bake the testnet's in; locally the store on disk is the whole
# of it.
# SHONIN_STORE_URL=https://testnet-store.shonin.fi

# A test wallet for trying the web app's money flows on the testnets: its own
# BIP-39 phrase, never one of the role mnemonics above, so no admin key is
# ever compiled into a page. EVM m/44'/60'/0'/0/0, Solana m/44'/501'/0'/0'.
# Only the app's development server (`task frontend:app:dev`) compiles it in;
# release and deploy builds never read it. Fund it with
# `task chains:fund-wallet NETWORK=testnet ADDRESS=<address> DOLLARS=<n>`.
# Keep it to testnet money: it sits in plain text here.
# SHONIN_DEV_WALLET_MNEMONIC=

# ---------------------------------------------------------------------------
# Local dev
# ---------------------------------------------------------------------------
# Base port; each service uses base + a fixed offset (see taskfiles/config.yml).
# The local chains' URLs in config/chains.toml assume the default, so moving
# the base also means overriding them above (SHONIN_RPC_EVM_31337, ...).
# SHONIN_START_PORT_DEV=19080

# The local chains hand out ten unlocked accounts from a mnemonic everyone
# knows, which is what makes them development chains. Each of the platform's
# roles is one of those accounts, by index, so no key is written down
# anywhere, here included:
#
#   0  admin      deploys the contracts, governs the allowlist, kills vaults
#   1  builder    signs (sourceHash, manifestHash) -> bundleHash
#   2  reviewer   signs review scores
#   3  executor   funds the per-vault keys the enclave would generate
#   4  keeper     crystallises fees and settles claims
#   5  author     publishes the reference agents
#   6  viewer     the account the web app's development wallet uses
#   7  operator   moves prices and funding on the local venue
#   8  attestor   stands in for the hardware a real deployment would trust
#   9  platform   receives the platform's fees
#
# The ops dashboard (http://localhost:19088/) lists them for each chain.

# Where the agents live, for `task services:seed`: the checkout the reference
# agents are published from. Defaults to a sibling checkout.
# SHONIN_AGENTS_DIR=

# The reviewer runs a pinned model through the Claude Code CLI. Unset it to run
# without reviews: every strategy then shows "review pending", which is a state
# the site has to handle anyway.
# SHONIN_REVIEW_MODEL=claude-sonnet-5

# The second half of a review: a model that answers a fixed battery of narrow
# questions, from which the reviewer computes the score with the weights in
# packages/machines/reviewer/review/battery.json. Unset it and the prose model
# scores the strategy itself, as it does today, and the report says so.
# SHONIN_CALIBRATOR_KEY=
# Defaults to the published endpoint and the version the image pins.
# SHONIN_CALIBRATOR_URL=
# SHONIN_CALIBRATOR_MODEL=
