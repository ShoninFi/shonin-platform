{
  // marketing — the marketing site's generated static pages, served as
  // Workers static assets. It has no public hostname yet: it takes shonin.fi
  // from shonin-landing once it is real, and until then it is reachable only
  // at its workers.dev address.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // `name` is the SINGLE SOURCE OF TRUTH for this Worker's name.
  "name": "shonin-marketing",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // Must match PATH_DIST_MARKETING in taskfiles/config.yml.
    "directory": "../../.trunk-dist/marketing",
    "not_found_handling": "404-page"
  }
}
